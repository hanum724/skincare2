<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GlowGuide Pro - Herbal & Dermatological Skincare Platform</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        emerald: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            200: '#bbf7d0',
                            300: '#86efac',
                            400: '#4ade80',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            800: '#166534',
                            900: '#14532d',
                            950: '#052e16',
                        },
                        sage: {
                            50: '#f4f7f4',
                            100: '#e3eae3',
                            200: '#c7d5c7',
                            300: '#a3baa3',
                            400: '#7b9a7c',
                            500: '#5c7c5d',
                            600: '#476248',
                            700: '#394e3a',
                            800: '#2f3f30',
                            900: '#273428',
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .glass-nav {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #86efac;
            border-radius: 10px;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased selection:bg-emerald-200 selection:text-emerald-900">

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-slate-900 text-white px-5 py-3 rounded-2xl shadow-2xl flex items-center gap-3">
        <i id="toast-icon" class="fa-solid fa-circle-check text-emerald-400 text-xl"></i>
        <span id="toast-msg" class="text-sm font-medium">Notifikasi</span>
    </div>

    <!-- 1. NAVBAR / HEADER -->
    <header class="fixed top-0 left-0 right-0 z-40 glass-nav border-b border-emerald-100 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Logo -->
            <a href="#" class="flex items-center gap-2 group">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-400 flex items-center justify-center text-white shadow-lg shadow-emerald-200 group-hover:scale-105 transition-transform">
                    <i class="fa-solid fa-sparkles text-lg"></i>
                </div>
                <span class="text-xl font-bold bg-gradient-to-r from-emerald-800 to-teal-600 bg-clip-text text-transparent">GlowGuide<span class="text-emerald-500 font-extrabold">Pro</span></span>
            </a>

            <!-- Desktop Nav Links -->
            <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-600">
                <a href="#hero" class="hover:text-emerald-600 transition-colors">Beranda</a>
                <a href="#konsultasi" class="hover:text-emerald-600 transition-colors">Konsultasi</a>
                <a href="#smart-budget" class="hover:text-emerald-600 transition-colors">Smart Budget</a>
                <a href="#quiz" class="hover:text-emerald-600 transition-colors">Skin Quiz</a>
                <a href="#katalog" class="hover:text-emerald-600 transition-colors">Katalog & Bahan</a>
                <a href="#pao-tracker" class="hover:text-emerald-600 transition-colors">Tracker PAO</a>
                <a href="#review" class="hover:text-emerald-600 transition-colors">Komunitas</a>
            </nav>

            <!-- Actions -->
            <div class="flex items-center gap-3">
                <button onclick="toggleCartModal()" class="relative p-2.5 text-slate-600 hover:text-emerald-600 hover:bg-emerald-50 rounded-xl transition-all">
                    <i class="fa-solid fa-bag-shopping text-xl"></i>
                    <span id="cart-count" class="absolute -top-1 -right-1 bg-emerald-600 text-white text-[10px] font-bold w-5 h-5 rounded-full flex items-center justify-center border-2 border-white">0</span>
                </button>
                <a href="#quiz" class="hidden sm:inline-flex items-center gap-2 bg-emerald-700 hover:bg-emerald-800 text-white px-5 py-2.5 rounded-xl font-semibold text-sm shadow-md shadow-emerald-200 hover:shadow-lg transition-all">
                    <i class="fa-solid fa-wand-magic-sparkles"></i> Analisis Kulit
                </a>
            </div>
        </div>
    </header>

    <!-- 2. HERO SECTION -->
    <section id="hero" class="pt-28 pb-16 lg:pt-36 lg:pb-24 bg-gradient-to-b from-emerald-50/60 via-slate-50 to-slate-50 overflow-hidden relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid lg:grid-cols-12 gap-12 items-center">
                <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-100/80 border border-emerald-200 text-emerald-800 text-xs font-semibold">
                        <i class="fa-solid fa-leaf text-emerald-600"></i> Platform Dermatologi & Botanical Skincare #1
                    </div>
                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 leading-tight">
                        Kulit Sehat & Impian Tanpa Over-budget dengan <span class="bg-gradient-to-r from-emerald-600 to-teal-600 bg-clip-text text-transparent">GlowGuide Pro</span>
                    </h1>
                    <p class="text-slate-600 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0">
                        Solusi terpadu analisis tipe kulit, konsultasi dokter spesialis terpercaya, edukasi bahan aktif herbal & klinis, serta rekomendasi produk pas di kantong.
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start pt-2">
                        <a href="#smart-budget" class="inline-flex justify-center items-center gap-2 bg-emerald-700 hover:bg-emerald-800 text-white px-7 py-3.5 rounded-2xl font-bold text-base shadow-xl shadow-emerald-200 hover:shadow-2xl transition-all transform hover:-translate-y-0.5">
                            <i class="fa-solid fa-calculator"></i> Fitur Smart Budget
                        </a>
                        <a href="#konsultasi" class="inline-flex justify-center items-center gap-2 bg-white border-2 border-emerald-600 text-emerald-700 hover:bg-emerald-50 px-7 py-3.5 rounded-2xl font-bold text-base transition-all">
                            <i class="fa-solid fa-user-doctor"></i> Tanya Dokter
                        </a>
                    </div>
                    <!-- Badges Stats -->
                    <div class="pt-8 border-t border-slate-200/80 grid grid-cols-3 gap-4">
                        <div>
                            <p class="text-2xl sm:text-3xl font-extrabold text-emerald-800">12K+</p>
                            <p class="text-xs sm:text-sm text-slate-500 font-medium">Pengguna Aktif</p>
                        </div>
                        <div>
                            <p class="text-2xl sm:text-3xl font-extrabold text-emerald-800">98%</p>
                            <p class="text-xs sm:text-sm text-slate-500 font-medium">Tingkat Kepuasan</p>
                        </div>
                        <div>
                            <p class="text-2xl sm:text-3xl font-extrabold text-emerald-800">50+</p>
                            <p class="text-xs sm:text-sm text-slate-500 font-medium">Dokter Estetika</p>
                        </div>
                    </div>
                </div>
                
                <!-- Hero Visual Graphic -->
                <div class="lg:col-span-5 relative">
                    <div class="relative mx-auto max-w-md lg:max-w-none">
                        <div class="absolute -top-6 -left-6 w-72 h-72 bg-emerald-300/30 rounded-full blur-3xl -z-10"></div>
                        <div class="absolute -bottom-6 -right-6 w-72 h-72 bg-teal-300/30 rounded-full blur-3xl -z-10"></div>
                        
                        <div class="bg-white p-6 rounded-3xl shadow-2xl border border-slate-100 space-y-4">
                            <div class="relative rounded-2xl overflow-hidden h-64 bg-emerald-900 flex items-center justify-center group">
                                <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&w=800&q=80" alt="Herbal Skincare" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90">
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent flex items-end p-5">
                                    <div class="text-white">
                                        <span class="bg-emerald-500/80 backdrop-blur-md text-xs font-bold px-2.5 py-1 rounded-md mb-2 inline-block">Rekomendasi Hari Ini</span>
                                        <h3 class="text-lg font-bold">Organics Botanical Serum</h3>
                                        <p class="text-xs text-slate-200">Ekstrak Centella Asiatica & Organic Tea Tree</p>
                                    </div>
                                </div>
                            </div>
                            <!-- Mini Card Feature Floating -->
                            <div class="flex items-center gap-4 bg-emerald-50/80 p-4 rounded-2xl border border-emerald-100">
                                <div class="w-12 h-12 rounded-xl bg-emerald-600 text-white flex items-center justify-center text-xl shrink-0">
                                    <i class="fa-solid fa-shield-halved"></i>
                                </div>
                                <div>
                                    <h4 class="text-sm font-bold text-slate-900">Dermatology Verified</h4>
                                    <p class="text-xs text-slate-500">Semua rekomendasi terverifikasi aman & BPOM.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. MODUL KONSULTASI DOKTER VIRTUAL -->
    <section id="konsultasi" class="py-16 bg-white border-y border-slate-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <span class="text-xs font-bold text-emerald-600 tracking-wider uppercase bg-emerald-50 px-3 py-1 rounded-full border border-emerald-100">Layanan Klinis</span>
                <h2 class="text-3xl font-bold text-slate-900 mt-2">Konsultasi Dokter Virtual</h2>
                <p class="text-slate-500 text-sm mt-1">Dapatkan saran medis pribadi langsung dari Dermatolog berpengalaman.</p>
            </div>

            <div class="grid lg:grid-cols-12 gap-8 items-start">
                <!-- Daftar Dokter -->
                <div class="lg:col-span-7 space-y-4">
                    <h3 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                        <i class="fa-solid fa-user-doctor text-emerald-600"></i> Pilih Dokter Spesialis
                    </h3>
                    <div id="doctor-list" class="space-y-3">
                        <!-- Iterasi Dokter via JS -->
                    </div>
                </div>

                <!-- Form Janji Temu / Konsultasi -->
                <div class="lg:col-span-5 bg-slate-50 p-6 rounded-3xl border border-slate-200 shadow-sm">
                    <h3 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                        <i class="fa-regular fa-calendar-check text-emerald-600"></i> Form Konsultasi
                    </h3>
                    <form id="consultation-form" onsubmit="handleConsultationSubmit(event)" class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Lengkap</label>
                            <input type="text" required placeholder="Contoh: Amanda Putri" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:outline-none text-sm bg-white">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Dokter Tujuan</label>
                            <input type="text" id="selected-doctor-input" readonly value="dr. Sarah Amalia, Sp.DVE" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-100 text-slate-600 text-sm font-medium">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Keluhan Kulit Utama</label>
                            <textarea rows="3" required placeholder="Jelaskan kondisi kulit, gatal, kemerahan, atau bruntusan..." class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:outline-none text-sm bg-white"></textarea>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Upload Foto Kondisi Kulit (Opsional)</label>
                            <input type="file" accept="image/*" class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-emerald-100 file:text-emerald-800 hover:file:bg-emerald-200">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Pilih Jadwal Konsultasi</label>
                            <input type="datetime-local" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:outline-none text-sm bg-white">
                        </div>
                        <button type="submit" class="w-full bg-emerald-700 hover:bg-emerald-800 text-white font-bold py-3 rounded-xl shadow-lg shadow-emerald-200 transition-all text-sm flex items-center justify-center gap-2">
                            <i class="fa-brands fa-whatsapp text-lg"></i> Hubungi Dokter via Chat Simulator
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. MODUL SMART BUDGET & CUSTOM RECOMMENDATIONS -->
    <section id="smart-budget" class="py-16 bg-slate-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <span class="text-xs font-bold text-emerald-600 tracking-wider uppercase bg-emerald-100 px-3 py-1 rounded-full border border-emerald-200">Fitur Pintar</span>
                <h2 class="text-3xl font-bold text-slate-900 mt-2">Smart Budget Skincare Calculator</h2>
                <p class="text-slate-500 text-sm mt-1">Atur budgetmu dan dapatkan paket rangkaian produk efektif secara instan.</p>
            </div>

            <!-- Controls Panel -->
            <div class="bg-white p-6 sm:p-8 rounded-3xl shadow-sm border border-slate-200 mb-8 space-y-6">
                <div class="grid md:grid-cols-3 gap-6">
                    <!-- Slider Budget -->
                    <div class="space-y-2">
                        <div class="flex justify-between items-center">
                            <label class="text-xs font-bold text-slate-700">Maksimal Budget:</label>
                            <span id="budget-value" class="text-base font-extrabold text-emerald-700">Rp 250.000</span>
                        </div>
                        <input type="range" id="budget-range" min="50000" max="1000000" step="25000" value="250000" oninput="updateBudgetFilter()" class="w-full accent-emerald-600 cursor-pointer h-2 bg-slate-200 rounded-lg">
                        <div class="flex justify-between text-[10px] text-slate-400">
                            <span>Rp 50rb</span>
                            <span>Rp 500rb</span>
                            <span>Rp 1 Juta+</span>
                        </div>
                    </div>

                    <!-- Filter Skin Type -->
                    <div class="space-y-2">
                        <label class="text-xs font-bold text-slate-700">Tipe Kulit:</label>
                        <select id="budget-skin-type" onchange="updateBudgetFilter()" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 text-sm bg-white font-medium">
                            <option value="all">Semua Tipe Kulit</option>
                            <option value="berminyak">Berminyak (Oily)</option>
                            <option value="kering">Kering (Dry)</option>
                            <option value="kombinasi">Kombinasi</option>
                            <option value="sensitif">Sensitif</option>
                        </select>
                    </div>

                    <!-- Filter Goal -->
                    <div class="space-y-2">
                        <label class="text-xs font-bold text-slate-700">Fokus Perawatan (Goal):</label>
                        <select id="budget-skin-goal" onchange="updateBudgetFilter()" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 text-sm bg-white font-medium">
                            <option value="all">Semua Focus</option>
                            <option value="jerawat">Jerawat / Acne Care</option>
                            <option value="mencerahkan">Mencerahkan / Brightening</option>
                            <option value="anti-aging">Anti-Aging & Firming</option>
                            <option value="barrier">Barrier Repair</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Recommendation Results Grid -->
            <div>
                <div class="flex justify-between items-center mb-4">
                    <h3 class="font-bold text-slate-800 text-lg">Paket & Produk Rekomendasi</h3>
                    <span id="results-count" class="text-xs text-slate-500 font-semibold">Menampilkan 0 produk</span>
                </div>
                <div id="budget-products-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                    <!-- Dynamic Items via JS -->
                </div>
            </div>
        </div>
    </section>

    <!-- 5. KUIS INTERAKTIF TIPE KULIT (SKIN ANALYZER) -->
    <section id="quiz" class="py-16 bg-gradient-to-b from-slate-50 to-emerald-50/40">
        <div class="max-w-4xl mx-auto px-4 sm:px-6">
            <div class="bg-white rounded-3xl shadow-xl border border-emerald-100 overflow-hidden">
                <!-- Quiz Header -->
                <div class="bg-emerald-800 p-6 sm:p-8 text-white text-center relative">
                    <span class="bg-emerald-700 text-emerald-200 text-xs font-bold px-3 py-1 rounded-full uppercase">Interactive Diagnostic</span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold mt-2">Skin Analyzer Quiz</h2>
                    <p class="text-emerald-100 text-xs sm:text-sm mt-1">Jawab 3 pertanyaan singkat untuk mengetahui diagnosis dasar kulitmu.</p>
                </div>

                <!-- Quiz Progress Bar -->
                <div class="w-full bg-slate-100 h-2">
                    <div id="quiz-progress" class="bg-emerald-500 h-2 w-1/3 transition-all duration-300"></div>
                </div>

                <!-- Quiz Container -->
                <div class="p-6 sm:p-10">
                    <div id="quiz-step-container">
                        <!-- Dynamic Steps via JS -->
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 6. KATALOG PRODUK & ENSIKLOPEDIA BAHAN AKTIF -->
    <section id="katalog" class="py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
            
            <!-- ENSIKLOPEDIA BAHAN AKTIF (INGREDIENTS) -->
            <div>
                <div class="text-center max-w-2xl mx-auto mb-10">
                    <span class="text-xs font-bold text-emerald-600 tracking-wider uppercase bg-emerald-50 px-3 py-1 rounded-full border border-emerald-100">Ensiklopedia Skincare</span>
                    <h2 class="text-3xl font-bold text-slate-900 mt-2">Edukasi Bahan Aktif & Botanical</h2>
                    <p class="text-slate-500 text-sm mt-1">Pahami manfaat setiap kandungan sebelum menerapkannya pada kulitmu.</p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" id="ingredients-grid">
                    <!-- Dynamic Ingredient Cards -->
                </div>
            </div>

            <!-- KATALOG PRODUK UTAMA -->
            <div class="pt-10 border-t border-slate-200">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                    <div>
                        <h2 class="text-2xl font-bold text-slate-900">Katalog Skincare Terpilih</h2>
                        <p class="text-slate-500 text-xs sm:text-sm">Produk herbal dan dermacosmetics terbaik.</p>
                    </div>

                    <!-- Filter Buttons -->
                    <div class="flex flex-wrap gap-2" id="catalog-category-filters">
                        <button onclick="filterCatalog('all')" class="cat-btn active text-xs font-semibold px-4 py-2 rounded-xl border border-emerald-600 bg-emerald-600 text-white transition-all">Semua</button>
                        <button onclick="filterCatalog('Cleanser')" class="cat-btn text-xs font-semibold px-4 py-2 rounded-xl border border-slate-200 bg-white text-slate-600 hover:border-emerald-500 transition-all">Cleanser</button>
                        <button onclick="filterCatalog('Serum')" class="cat-btn text-xs font-semibold px-4 py-2 rounded-xl border border-slate-200 bg-white text-slate-600 hover:border-emerald-500 transition-all">Serum</button>
                        <button onclick="filterCatalog('Moisturizer')" class="cat-btn text-xs font-semibold px-4 py-2 rounded-xl border border-slate-200 bg-white text-slate-600 hover:border-emerald-500 transition-all">Moisturizer</button>
                        <button onclick="filterCatalog('Sunscreen')" class="cat-btn text-xs font-semibold px-4 py-2 rounded-xl border border-slate-200 bg-white text-slate-600 hover:border-emerald-500 transition-all">Sunscreen</button>
                    </div>
                </div>

                <div id="catalog-grid" class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    <!-- Dynamic Catalog Items -->
                </div>
            </div>

        </div>
    </section>

    <!-- 7. FITUR PENGINGAT MASA KEDALUWARSA (PAO - PERIOD AFTER OPENING TRACKER) -->
    <section id="pao-tracker" class="py-16 bg-slate-900 text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid lg:grid-cols-12 gap-12 items-center">
                <div class="lg:col-span-5 space-y-4">
                    <span class="text-xs font-bold text-emerald-400 tracking-wider uppercase bg-emerald-950 px-3 py-1 rounded-full border border-emerald-800">Safety & Expiry</span>
                    <h2 class="text-3xl font-extrabold text-white">PAO Tracker (Period After Opening)</h2>
                    <p class="text-slate-400 text-sm">
                        Produk skincare yang sudah dibuka memiliki masa pakai terbatas (misal: 6 bulan atau 12 bulan). Catat produkmu di sini untuk memantau sisa hari keamanannya!
                    </p>

                    <!-- Add PAO Form -->
                    <form id="pao-form" onsubmit="addPAOItem(event)" class="bg-slate-800/80 p-5 rounded-2xl border border-slate-700 space-y-3 mt-4">
                        <h4 class="text-sm font-bold text-emerald-300">Tambah Produk Baru</h4>
                        <div>
                            <input type="text" id="pao-name" required placeholder="Nama Produk (mis: Vitamin C Serum)" class="w-full px-3.5 py-2 rounded-xl bg-slate-900 border border-slate-700 text-xs text-white focus:ring-1 focus:ring-emerald-400 focus:outline-none">
                        </div>
                        <div class="grid grid-cols-2 gap-3">
