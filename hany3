                // Show Result
                progress.style.width = '100%';
                const detectedType = quizAnswers[0] || 'kombinasi';
                container.innerHTML = `
                    <div class="text-center py-6 space-y-4">
                        <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto text-2xl">
                            <i class="fa-solid fa-square-check"></i>
                        </div>
                        <h3 class="text-xl font-bold text-slate-800">Analisis Kulit Selesai!</h3>
                        <p class="text-sm text-slate-600">Berdasarkan jawabanmu, jenis kulit utamamu cenderung: <br><strong class="text-emerald-700 uppercase tracking-wider text-base">${detectedType}</strong></p>
                        <div class="pt-4 flex justify-center gap-3">
                            <button onclick="resetQuiz()" class="px-4 py-2 border border-slate-300 rounded-xl text-xs font-semibold text-slate-600">Ulangi Kuis</button>
                            <a href="#smart-budget" onclick="applyQuizToBudget('${detectedType}')" class="px-5 py-2 bg-emerald-700 text-white rounded-xl text-xs font-bold shadow-md">Lihat Rekomendasi Skincare</a>
                        </div>
                    </div>
                `;
                return;
            }

            // Update Progress
            progress.style.width = `${((currentQuizStep + 1) / quizQuestions.length) * 100}%`;

            const q = quizQuestions[currentQuizStep];
            container.innerHTML = `
                <div class="space-y-6">
                    <span class="text-xs font-bold text-emerald-600 uppercase">Pertanyaan ${currentQuizStep + 1} dari ${quizQuestions.length}</span>
                    <h3 class="text-lg sm:text-xl font-bold text-slate-800">${q.title}</h3>
                    <div class="grid gap-3">
                        ${q.options.map((opt, idx) => `
                            <button onclick="answerQuiz('${opt.type}')" class="p-4 text-left border border-slate-200 rounded-2xl hover:border-emerald-500 hover:bg-emerald-50/50 transition-all text-sm font-medium text-slate-700 flex justify-between items-center group">
                                <span>${opt.text}</span>
                                <i class="fa-solid fa-chevron-right text-xs text-slate-300 group-hover:text-emerald-600"></i>
                            </button>
                        `).join('')}
                    </div>
                </div>
            `;
        }

        function answerQuiz(type) {
            quizAnswers.push(type);
            currentQuizStep++;
            renderQuiz();
        }

        function resetQuiz() {
            currentQuizStep = 0;
            quizAnswers = [];
            renderQuiz();
        }

        function applyQuizToBudget(type) {
            document.getElementById('budget-skin-type').value = type;
            updateBudgetFilter();
        }

        // --- PAO TRACKER SYSTEM ---
        function renderPAOList() {
            const list = document.getElementById('pao-list');
            document.getElementById('pao-count-badge').innerText = `${paoItems.length} Produk`;

            if (paoItems.length === 0) {
                list.innerHTML = `<p class="text-xs text-slate-500 py-4 text-center">Belum ada produk yang dicatat.</p>`;
                return;
            }

            list.innerHTML = paoItems.map(item => {
                const openDate = new Date(item.dateOpened);
                const expDate = new Date(openDate);
                expDate.setMonth(expDate.getMonth() + parseInt(item.months));

                const today = new Date();
                const diffTime = expDate - today;
                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

                let statusColor = "bg-emerald-500/20 text-emerald-300 border-emerald-600";
                let statusText = `${diffDays} Hari Sisa`;

                if (diffDays <= 0) {
                    statusColor = "bg-rose-500/20 text-rose-300 border-rose-600";
                    statusText = "Kedaluwarsa!";
                } else if (diffDays <= 30) {
                    statusColor = "bg-amber-500/20 text-amber-300 border-amber-600";
                    statusText = `${diffDays} Hari Lagi`;
                }

                return `
                    <div class="p-3 bg-slate-900 rounded-xl border border-slate-700 flex items-center justify-between text-xs">
                        <div>
                            <h5 class="font-bold text-white">${item.name}</h5>
                            <p class="text-[10px] text-slate-400">Dibuka: ${item.dateOpened} (${item.months} Bulan PAO)</p>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="px-2.5 py-1 rounded-full border ${statusColor} text-[10px] font-bold">
                                ${statusText}
                            </span>
                            <button onclick="removePAO(${item.id})" class="text-slate-500 hover:text-rose-400"><i class="fa-solid fa-trash-can"></i></button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function addPAOItem(e) {
            e.preventDefault();
            const name = document.getElementById('pao-name').value;
            const dateOpened = document.getElementById('pao-date').value;
            const months = document.getElementById('pao-months').value;

            const newItem = {
                id: Date.now(),
                name,
                dateOpened,
                months
            };

            paoItems.push(newItem);
            localStorage.setItem('glow_pao_items', JSON.stringify(paoItems));
            renderPAOList();
            document.getElementById('pao-form').reset();
            showToast("Produk berhasil ditambahkan ke Tracker PAO!");
        }

        function removePAO(id) {
            paoItems = paoItems.filter(i => i.id !== id);
            localStorage.setItem('glow_pao_items', JSON.stringify(paoItems));
            renderPAOList();
            showToast("Produk dihapus dari Tracker.");
        }

        // --- REVIEWS SYSTEM ---
        function renderReviews() {
            const grid = document.getElementById('reviews-grid');
            grid.innerHTML = reviewsData.map(rev => `
                <div class="p-5 bg-white rounded-2xl border border-slate-200 shadow-sm space-y-3">
                    <div class="flex justify-between items-center">
                        <h4 class="font-bold text-slate-800 text-sm">${rev.name}</h4>
                        <span class="text-xs text-slate-400">${rev.time}</span>
                    </div>
                    <div class="text-amber-400 text-xs">
                        ${'★'.repeat(rev.rating)}
                    </div>
                    <p class="text-xs text-slate-600 leading-relaxed">"${rev.comment}"</p>
                </div>
            `).join('');
        }

        function toggleReviewForm() {
            const form = document.getElementById('review-form-container');
            form.classList.toggle('hidden');
        }

        function handleReviewSubmit(e) {
            e.preventDefault();
            const name = document.getElementById('rev-name').value;
            const rating = parseInt(document.getElementById('rev-rating').value);
            const comment = document.getElementById('rev-comment').value;

            reviewsData.unshift({
                id: Date.now(),
                name,
                rating,
                comment,
                time: "Baru saja"
            });

            renderReviews();
            toggleReviewForm();
            showToast("Ulasan Anda berhasil ditambahkan!");
        }

        // --- SIMULATED CART LOGIC ---
        function addToCart(productId) {
            const product = productsData.find(p => p.id === productId);
            if (product) {
                cart.push(product);
                updateCartUI();
                showToast(`${product.name} ditambahkan ke keranjang.`);
            }
        }

        function updateCartUI() {
            document.getElementById('cart-count').innerText = cart.length;
            const container = document.getElementById('cart-items-container');
            
            if (cart.length === 0) {
                container.innerHTML = `<p class="text-center text-xs text-slate-400 py-6">Keranjang simulasi masih kosong.</p>`;
                document.getElementById('cart-total-price').innerText = 'Rp 0';
                return;
            }

            let total = 0;
            container.innerHTML = cart.map((item, idx) => {
                total += item.price;
                return `
                    <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-xl border border-slate-200">
                        <div class="flex items-center gap-2">
                            <img src="${item.image}" class="w-10 h-10 rounded-lg object-cover" alt="${item.name}">
                            <div>
                                <h5 class="text-xs font-bold text-slate-800 line-clamp-1">${item.name}</h5>
                                <p class="text-[10px] text-emerald-700 font-extrabold">Rp ${item.price.toLocaleString('id-ID')}</p>
                            </div>
                        </div>
                        <button onclick="removeFromCart(${idx})" class="text-slate-400 hover:text-rose-500 text-xs p-1"><i class="fa-solid fa-xmark"></i></button>
                    </div>
                `;
            }).join('');

            document.getElementById('cart-total-price').innerText = `Rp ${total.toLocaleString('id-ID')}`;
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            updateCartUI();
        }

        function toggleCartModal() {
            document.getElementById('cart-modal').classList.toggle('hidden');
        }

        function checkoutSimulation() {
            if (cart.length === 0) {
                showToast("Keranjang Anda masih kosong!");
                return;
            }
            cart = [];
            updateCartUI();
            toggleCartModal();
            showToast("Simulasi Pembelian Berhasil! Terima kasih.");
        }

        // --- CONSULTATION SIMULATOR ---
        function handleConsultationSubmit(e) {
            e.preventDefault();
            const doc = document.getElementById('selected-doctor-input').value;
            showToast(`Mengubungkan ke Live WhatsApp Simulation dengan ${doc}...`);
        }

        // --- TOAST UTILITY ---
        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').innerText = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        // --- INIT ON LOAD ---
        window.onload = function() {
            renderDoctors();
            updateBudgetFilter();
            renderIngredients();
            filterCatalog('all');
            renderQuiz();
            renderPAOList();
            renderReviews();
            updateCartUI();

            // Set Default PAO Date to Today
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('pao-date').value = today;
        }
    </script>
</body>
</html>
